# Odoo chinh (Main). Bat buoc.
EDGE_MAIN_URL=http://odoo-main.local:8069

# Ma dang ky cua edge nay (edge_code). Tu sinh lan dau neu bo trong, sau do GHI CO DINH
# vao state file - phai giong voi pcm.edge.code ben Odoo (hoac de Odoo tu tao ban ghi
# "cho duyet" bang chinh ma nay khi hello lan dau).
EDGE_CODE=EDGE-LINE1

# Ten hien thi de Odoo dat cho ban ghi pcm.edge khi tu dang ky lan dau.
EDGE_NAME=Edge LINE1

# ubuntu | windows | other
EDGE_PLATFORM=ubuntu

# Dia chi LAN cua chinh edge nay, de Odoo/tablet goi nguoc vao /api/command,
# /api/latest, /api/browse, /api/source/test, /api/stats (vd http://10.10.1.50:8000).
EDGE_BASE_URL=http://10.10.1.50:8000

# Cong HTTP inbound cua edge (Odoo -> edge).
EDGE_LISTEN_HOST=0.0.0.0
EDGE_LISTEN_PORT=8000

# Noi luu state (api_key sau hello, config cache, lich su do, hang doi offline).
EDGE_STATE_DIR=./var

# IP/CIDR cua reverse-proxy/tunnel duoc TIN de doc X-Forwarded-Proto/-Host (uvicorn
# ProxyHeadersMiddleware). Mac dinh chi trust loopback - DUNG NGUYEN neu edge chi
# truy cap qua LAN truc tiep. Chi doi khi dat edge_collector sau 1 reverse-proxy/
# tunnel TLS-terminating (vd truy cap /setup qua domain public https://) - neu khong
# se bi reject nham "possible CSRF" do uvicorn khong biet request that su la https.
EDGE_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Chu ky (giay)
EDGE_HELLO_INTERVAL_S=30
EDGE_HEARTBEAT_INTERVAL_S=30
EDGE_CONFIG_POLL_INTERVAL_S=30
EDGE_PRINT_POLL_INTERVAL_S=3
EDGE_SUBMIT_INTERVAL_S=2
EDGE_CONFIG_DEBOUNCE_S=10
